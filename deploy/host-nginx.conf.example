# Host nginx reverse proxy for joshuadolor.com
# Copy to the server, then:
#   sudo cp deploy/host-nginx.conf.example /etc/nginx/sites-available/portfolio
#   sudo ln -sf /etc/nginx/sites-available/portfolio /etc/nginx/sites-enabled/portfolio
#   sudo nginx -t && sudo systemctl reload nginx
# Issue TLS after DNS points here:
#   sudo certbot --nginx -d joshuadolor.com -d www.joshuadolor.com
#
# proxy_pass port must match PORTFOLIO_PORT in /opt/portfolio/.env (default 8080).

server {
    listen 80;
    listen [::]:80;
    server_name joshuadolor.com www.joshuadolor.com;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
